<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IPSys.Web</AssemblyName>
    <RootNamespace>IPSys.Web</RootNamespace>
    <!-- The Windows PE executable and WinForms launcher share this application icon. -->
    <ApplicationIcon>assets\IPSys.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Debug remains multi-file; Release Publish is framework-dependent and produces one EXE. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- IPSys serves embedded assets through MapGet; neither IIS nor static-web-assets manifests are used. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the same icon available as an in-assembly WinForms resource. -->
    <EmbeddedResource Include="assets\IPSys.ico" LogicalName="IPSys.Web.AppIcon.ico" />
    <!-- Embed HTML/CSS/JS into the executable, no external wwwroot folder. -->
    <Content Remove="wwwroot\**\*" />
    <None Remove="wwwroot\**\*" />
    <!-- The one official frontend lives in wwwroot/{index.html,css,js}.
         wwwroot/dist is generated during builds and is never committed. -->
    <EmbeddedResource Include="wwwroot\dist\index.html" LogicalName="IPSys.Web.Embedded.index.html" />
    <EmbeddedResource Include="wwwroot\dist\style.css" LogicalName="IPSys.Web.Embedded.style.css" />
    <EmbeddedResource Include="wwwroot\dist\app.js" LogicalName="IPSys.Web.Embedded.app.js" />
    <!-- Frontend capability modules are embedded under the same web resource namespace. -->
    <EmbeddedResource Include="wwwroot\ip-v2.js" LogicalName="IPSys.Web.Embedded.ip-v2.js" />
    <EmbeddedResource Include="wwwroot\upload-progress.js" LogicalName="IPSys.Web.Embedded.upload-progress.js" />
    <EmbeddedResource Include="wwwroot\export.js" LogicalName="IPSys.Web.Embedded.export.js" />
    <EmbeddedResource Include="wwwroot\pdfjs\pdf.min.js" LogicalName="IPSys.Web.Embedded.pdf.min.js" />
    <EmbeddedResource Include="wwwroot\pdfjs\pdf.worker.min.js" LogicalName="IPSys.Web.Embedded.pdf.worker.min.js" />
    <EmbeddedResource Include="wwwroot\pdf-preview.js" LogicalName="IPSys.Web.Embedded.pdf-preview.js" />
    <EmbeddedResource Include="wwwroot\pdfjs\LICENSE.txt" LogicalName="IPSys.Web.Embedded.pdfjs.LICENSE.txt" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <!-- 正式前端源码位于 wwwroot/{index.html,css,js}；wwwroot/dist 为构建生成目录。
       如果没有 Node，沿用现有 dist 并提示风险；缺少产物则构建失败。 -->
  <PropertyGroup>
    <ExplorerRoot>$(MSBuildProjectDirectory)\wwwroot</ExplorerRoot>
  </PropertyGroup>
  <Target Name="BundleExplorerShell" BeforeTargets="BeforeBuild">
    <Exec Command="node --version" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ExplorerNodeExit" />
    </Exec>
    <Exec Condition="'$(ExplorerNodeExit)' == '0'"
          Command="node &quot;$(ExplorerRoot)\tools\bundle.cjs&quot;" />
    <Error Condition="'$(ExplorerNodeExit)' != '0' And !Exists('$(ExplorerRoot)\dist\app.js')"
           Text="前端产物缺失，且未找到 Node.js。请安装 Node.js，或手动运行 node src/IPSys.Web/wwwroot/tools/bundle.cjs 后重新编译。" />
    <Warning Condition="'$(ExplorerNodeExit)' != '0' And Exists('$(ExplorerRoot)\dist\app.js')"
             Text="未找到 Node.js，跳过前端打包，直接使用已有的 dist/。若改动过 wwwroot 下的源码，这份产物是旧的。" />
  </Target>
</Project>